diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index 553cb6ae..c5f559d9 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -75,6 +75,69 @@ static char __user *empty_user_path(void)
 
 static const char su_path[] = SU_PATH;
 
+/* susfs_stage5_trial21_samsung419_vfs_facessat_bridge
+ *
+ * Samsung 4.19 manual-VFS bridge for SUSFS 2.3.0.  KSUN 3.3.0's stock
+ * sucompat path on this tree is syscall-regs based, so expose the narrow
+ * current-SUSFS faccessat ABI without replacing the proven syscall bridge.
+ */
+bool ksu_sucompat_enabled_samsung419(void)
+{
+	return READ_ONCE(ksu_su_compat_enabled);
+}
+
+/* susfs_stage5_trial22_samsung419_vfs_stat_bridge */
+int ksu_handle_stat_samsung419(int *dfd,
+			       const char __user **filename_user,
+			       int *flags)
+{
+	static const char sh_path[] = SH_PATH;
+	char path[sizeof(su_path) + 1] = { 0 };
+	char __user *replacement;
+
+	if (!filename_user || !*filename_user)
+		return 0;
+	if (!ksu_is_allow_uid_for_current(current_uid().val))
+		return 0;
+
+	if (strncpy_from_user(path, *filename_user, sizeof(path)) < 0)
+		return 0;
+
+	if (unlikely(!memcmp(path, su_path, sizeof(su_path)))) {
+		replacement = userspace_stack_buffer(sh_path, sizeof(sh_path));
+		if (replacement)
+			*filename_user = replacement;
+	}
+	return 0;
+}
+
+int ksu_handle_faccessat_samsung419(int *dfd,
+				    const char __user **filename_user,
+				    int *mode, int *__unused_flags)
+{
+	static const char sh_path[] = SH_PATH;
+	char path[sizeof(su_path) + 1] = { 0 };
+	char __user *replacement;
+
+	if (!filename_user || !*filename_user)
+		return 0;
+	if (!ksu_is_allow_uid_for_current(current_uid().val))
+		return 0;
+
+	if (strncpy_from_user(path, *filename_user, sizeof(path)) < 0)
+		return 0;
+
+/* susfs_stage6_trial53_faccessat_redirect_result */
+	if (unlikely(!memcmp(path, su_path, sizeof(su_path)))) {
+		replacement = userspace_stack_buffer(sh_path, sizeof(sh_path));
+		if (replacement) {
+			*filename_user = replacement;
+			return 1;
+		}
+	}
+	return 0;
+}
+
 static bool is_ksud_exists()
 {
 	struct path path;
